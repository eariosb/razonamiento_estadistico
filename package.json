{
  "name": "curso-razonamiento-estadistico",
  "version": "0.1.0",
  "private": true,
  "description": "Razonamiento Estadístico: curso interactivo sobre heurísticas, sesgos y corrección formal de la intuición, con R en el navegador (webR), simulaciones y laboratorio de errores cognitivos. En la tradición de Kahneman y Tversky. Universidad Nacional de Colombia, sede Medellín.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:mdx": "tsx scripts/check_mdx.mjs",
    "check:r": "python scripts/run_all_r.py --check",
    "check:r:update": "python scripts/run_all_r.py --update",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "qa": "pnpm typecheck && pnpm build && pnpm test && pnpm check:mdx && pnpm check:r && pnpm test:visual"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@cursos/blackboard": "workspace:*",
    "@excalidraw/excalidraw": "^0.18.1",
    "@uiw/react-codemirror": "^4.23.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "katex": "^0.16.11",
    "lucide-react": "^1.52.0",
    "next": "^15.1.6",
    "next-mdx-remote": "^6.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "webr": "^0.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
