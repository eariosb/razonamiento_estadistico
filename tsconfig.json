{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "types": ["vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@cursos/blackboard": ["./packages/blackboard/src/index.ts"],
      "@cursos/blackboard/rag": ["./packages/blackboard/src/lib/rag/index.ts"],
      "@cursos/blackboard/persistence": ["./packages/blackboard/src/lib/persistence/index.ts"],
      "@cursos/blackboard/assistant": ["./packages/blackboard/src/lib/assistant/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
